VITE_USE_MOCKS=false

# First deploy: set this to the Railway backend public domain.
# Example: https://backend-production-xxxx.up.railway.app
VITE_API_BASE_URL=https://replace-with-your-backend.up.railway.app

# Optional. Usually not needed because the app derives this from VITE_API_BASE_URL.
# VITE_WS_MARKET_URL=wss://replace-with-your-backend.up.railway.app/api/market/ws
